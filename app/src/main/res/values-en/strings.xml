    <string name="faq_title">FAQ</string>
    <string name="faq_cd">Help</string>
    <string name="theme_toggle_cd">Toggle theme</string>
    <string name="faq_transport_title">Why is the container/wagon number “incorrect”?</string>
    <string name="faq_transport_body">Wagon number format: 8 digits. Container number format: 4 Latin letters + 7 digits. Numbers are also checked with a check digit. If a transport number is marked incorrect, verify the data.</string>
    <string name="faq_delete_pallets_title">Deleting pallets</string>
    <string name="faq_delete_pallets_body">Swipe left on the pallet row you want to delete. A confirmation dialog will appear.</string>
    <string name="faq_double_control_title">Double control</string>
    <string name="faq_double_control_body">Each pallet shows an “Imported” mark. Actual loaded places are counted only for pallets marked as imported.</string>
    <string name="faq_forecast_title">Pallet forecast</string>
    <string name="faq_forecast_body">After you enter places on the first pallet, the app estimates how many pallets you need and the remainder.</string>
    <string name="faq_batch_title">Batch control</string>
    <string name="faq_batch_body">You can set limits per product. When loaded places for a product exceed the limit, a notification appears.</string>
    <string name="faq_gross_title">Gross weight</string>
    <string name="faq_gross_body">Includes a coefficient (default 1.05) and the “Gross tare” and “Gross weight” fields.</string>
    <string name="faq_fab_title">Floating “+” button</string>
    <string name="faq_fab_body">Quickly adds a pallet for the last used product. You can drag it by holding, or turn it off in Settings.</string>
    <string name="faq_simple_counter_title">Simplified counter</string>
    <string name="faq_simple_counter_body">Shows a “Places per pallet” field next to “Add pallet”: the value is applied immediately when adding (from the button or from “+”).</string>
    <string name="faq_input_guard_title">Input check</string>
    <string name="faq_input_guard_body">If tare or places per pallet exceed the set threshold, a confirmation appears. This helps catch typos.</string>
    <string name="faq_autospacing_title">Auto-spacing</string>
    <string name="faq_autospacing_body">Container numbers: XXXX1234567 → XXXX 1234567\nVehicle plates: X123XX456 → X 123 XX / 456\nNumber grouping: 10000 → 10 000</string>
    <string name="faq_prep_checklist_title">“Preparation” checklist (in schedule)</string>
    <string name="faq_prep_checklist_body">Things to do before work starts. Status is shown on the scheduled shipment card and in the notification. When work starts, unfinished preparation items are moved into the shipment checklist.</string>
    <string name="faq_shipment_checklist_title">“Shipment checklist” (in shipment)</string>
    <string name="faq_shipment_checklist_body">Things to do during work. If the checklist is incomplete, a warning appears before finishing the shipment.</string>
    <string name="faq_start_schedule_title">Start from schedule</string>
    <string name="faq_start_schedule_body">The “Start” button in the notification creates a shipment from the schedule template — with all pre-filled data.</string>
    <string name="faq_drafts_title">Drafts and duplicates</string>
    <string name="faq_drafts_body">A draft is saved automatically 3 seconds after the last action. You can also save a draft with the button. Drafts can be duplicated, like archive entries — for similar shipments.</string>
    <string name="faq_history_title">History</string>
    <string name="faq_history_body">A session action log with timestamps. Saved in the archive with the completed shipment.</string>
</resources>
